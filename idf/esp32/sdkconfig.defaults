# Match the installed Arduino recovery bootloader flash clock.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Move infrequently accessed Matter data-model objects into unused instruction
# RAM using the SDK's supported byte-access exception handler. Rendering frames
# also use this pool; the SPI DMA waveform, Lua and radio buffers stay in DRAM.
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_IRAM_8BIT=y
# ESP-IDF requires single-core mode for its IRAM byte-access handler.
CONFIG_FREERTOS_UNICORE=y
# Use the same internal IRAM reserve for transient Matter/signature crypto.
CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC=y

# Keep LED refill interrupts running during NVS/LittleFS flash operations.
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=y
